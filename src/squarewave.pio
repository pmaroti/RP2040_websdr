; Square wave generators, based on pmaroti/am_generator.
;
; squarewave:      2 PIO cycles per period, f = clk_sys / (2 * div)
;                  covers about 1 kHz to 62.5 MHz at 125 MHz clk_sys
; squarewave_slow: 64 PIO cycles per period, f = clk_sys / (64 * div)
;                  covers about 30 Hz to 1.9 MHz, used below 10 kHz
;
; How it works
; ------------
; A PIO state machine executes one instruction per PIO clock. The PIO clock is
; the system clock (clk_sys, 125 MHz by default) divided by the state
; machine's clock divider `div`, which can be 1.0 to 65536 in steps of 1/256.
;
; Each program below is an endless loop that sets the pin high, then low.
; Because the loop always takes a fixed number of PIO clocks, the output
; frequency is simply  clk_sys / (clocks_per_period * div), and the CPU
; changes the frequency by changing `div` (see squarewave.c). The CPU is not
; involved in generating the wave at all.
;
; Two programs are needed because the divider's range is limited:
;   - the 2-clock loop reaches up to clk_sys / 2, but at the largest divider
;     (65536) it can't go lower than about 950 Hz;
;   - the 64-clock loop uses instruction delays to make each period 32 times
;     longer, reaching down to about 30 Hz.
;
; The C file built from this one (squarewave.pio.h, generated by
; pico_generate_pio_header in CMakeLists.txt) contains the assembled
; instructions and a *_get_default_config() helper for each program.
;
; PIO assembly quick reference for what's used here:
;   .program NAME     starts a program
;   set pindirs, 1    make the "set" pin an output
;   set pins, X       drive the "set" pin to X (0 or 1)
;   [N]               after the instruction, wait N extra PIO clocks
;   .wrap_target /    the program counter jumps from .wrap back to
;   .wrap             .wrap_target for free (no jmp instruction, no extra clock)

.program squarewave
    set pindirs, 1      ; runs once at start: pin becomes an output
.wrap_target
    set pins, 1         ; 1 clock high
    set pins, 0         ; 1 clock low, then wrap back: period = 2 clocks
.wrap

.program squarewave_slow
    set pindirs, 1      ; runs once at start: pin becomes an output
.wrap_target
    set pins, 1 [31]    ; 1 + 31 delay = 32 clocks high
    set pins, 0 [31]    ; 32 clocks low, then wrap back: period = 64 clocks
.wrap
